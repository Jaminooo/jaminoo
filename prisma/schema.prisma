generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  email        String    @default("")
  passwordHash String?
  questionId   Int? // index into SECURITY_QUESTIONS
  answerHash   String?
  avatarId     Int       @default(0)
  bio          String    @default("")
  github       Boolean   @default(false)
  githubLogin  String?   @unique
  google       Boolean   @default(false)
  googleLogin  String?   @unique
  status       String    @default("ONLINE") // ONLINE | IDLE | BUSY | OFFLINE
  statusText   String    @default("")
   createdAt    DateTime  @default(now())
   isAdmin      Boolean   @default(false)
   adminRoles   AdminRole[]
   bannedUntil  DateTime?
  bannedReason String    @default("")

  profilePhotoId String?  @unique
  profilePhoto   Media?  @relation("ProfilePhoto", fields: [profilePhotoId], references: [id], onDelete: SetNull)

  name         String    @default("")
  website      String    @default("")
  location     String    @default("")
  bannerPhotoId String?   @unique
  bannerPhoto  Media?     @relation("ProfileBanner", fields: [bannerPhotoId], references: [id], onDelete: SetNull)

  sessions        Session[]
  friendRequestsA FriendRequest[] @relation("FriendRequestA")
  friendRequestsB FriendRequest[] @relation("FriendRequestB")
  ownedJams       Jam[]
  jams            JamMember[]
  messages        JamMessage[]
  media           Media[]
  convA           Conversation[] @relation("ConvA")
  convB           Conversation[] @relation("ConvB")
  dmMessages      DmMessage[]
  jamInvitesSent     JamInvite[] @relation("JamInviteFrom")
  jamInvitesReceived JamInvite[] @relation("JamInviteTo")
  reactions       Reaction[]
  queueAdds       JamQueueItem[] @relation("JamQueueAdd")
  favoriteSongs   SongFavorite[]
  playHistory     SongPlayHistory[]
  musicPlaylists  UserMusicPlaylist[]
  queueVotes      JamQueueVote[]
  skipVotes       JamSkipVote[]
  notifications   Notification[]
  reports           MessageReport[]
  communitiesOwned  Community[] @relation("CommunityOwned")
  communityMemberships CommunityMember[]
  communityChannelsCreated CommunityChannel[] @relation("CommunityChannelsCreated")
  communityMessages CommunityMessage[]
  creatorApplications CreatorApplication[]
  videoPosts      VideoPost[]
  videoLikes      VideoLike[]
  videoSaves      VideoSave[]
  videoComments   VideoComment[]
  followingCreators CreatorFollow[] @relation("CreatorFollowing")
  creatorFollowers  CreatorFollow[] @relation("CreatorFollowers")
  moments           JamMoment[]
  collabSent        VideoCollabInvite[] @relation("CollabSent")
  collabReceived    VideoCollabInvite[] @relation("CollabReceived")
  videoPlaylists    VideoPlaylist[]
  tweets            Tweet[] @relation("UserTweets")
  tweetLikes        TweetLike[] @relation("TweetLikes")
  tweetBookmarks    TweetBookmark[] @relation("TweetBookmarks")
  bookmarkCollections TweetBookmarkCollection[] @relation("TweetBookmarkCollections")
  tweetFollowing    TweetFollow[] @relation("TweetFollowing")
  tweetFollowers   TweetFollow[] @relation("TweetFollowers")
  followRequestsSent    TweetFollowRequest[] @relation("FollowRequestSent")
  followRequestsReceived TweetFollowRequest[] @relation("FollowRequestReceived")
  tweetBlocks       TweetBlock[]  @relation("TweetBlocking")
  tweetBlockedBy    TweetBlock[]  @relation("TweetBlocked")
  tweetMutes        TweetMute[]   @relation("TweetMuting")
  tweetMutedBy      TweetMute[]   @relation("TweetMuted")
  notificationPrefs NotificationPreference[]
  drafts            Draft[]
  scheduledTweets   ScheduledTweet[]
  tweetViews        TweetView[] @relation("TweetViewer")
  pollVotes         PollVote[] @relation("PollVoter")
  tweetMentioned    TweetMention[] @relation("TweetMentioned")
  tweetListsOwned   TweetList[] @relation("TweetListOwner")
  tweetListMemberships TweetListMember[] @relation("TweetListMemberships")
  pinnedTweet       Tweet? @relation("UserPinnedTweet", fields: [pinnedTweetId], references: [id], onDelete: SetNull)
  tweetMods         TweetMod[]

  isPrivate Boolean @default(false)
  pinnedTweetId Int? @unique

  isGuest    Boolean   @default(false)
  guestUntil DateTime?
}

model AdminRole {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  role      String   @default("HUB") // SUPER | HUB
  scope     String   @default("")    // "" for SUPER, otherwise a hub scope (MUSIC | VIDEO | ANIME | CINEMA | TWEET | COMMUNITY | ALL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([role, scope])
}

model Session {
  token     String   @id
  userId    Int
  kind      String   @default("USER") // USER | GUEST
  name      String   @default("")
  device    String   @default("")
  country   String   @default("")
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FriendRequest {
  id        Int      @id @default(autoincrement())
  fromId    Int
  toId      Int
  status    SRequest @default(PENDING) // PENDING | FRIENDS
  createdAt DateTime @default(now())

  from User @relation("FriendRequestA", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("FriendRequestB", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
}

enum SRequest {
  PENDING
  FRIENDS
}

enum JType {
  PUBLIC
  PRIVATE
}

model Jam {
  id        String   @id
  name      String
  desc      String   @default("")
  type      JType    @default(PUBLIC)
  kind      String   @default("CHAT") // CHAT | MOVIE | MUSIC | HANGOUT
  ownerId   Int
  closed    Boolean  @default(false)
  createdAt DateTime @default(now())

  currentSongId    Int?
  currentStartedAt DateTime?
  currentPlaying   Boolean  @default(false)
  currentPosition  Int      @default(0)
  autodj           Boolean  @default(true) // Auto-DJ: keep playing from member taste when the queue is empty
  currentAutoDj    Boolean  @default(false) // Last started song was picked by Auto-DJ
  currentCinemaVideoId Int?
  currentCinemaStartedAt DateTime?
  currentCinemaPlaying Boolean @default(false)
  currentCinemaPosition Int @default(0)

  currentAnimeEpisodeId   Int?
  currentAnimePlaying     Boolean @default(false)
  currentAnimePosition    Int     @default(0)
  currentAnimeStartedAt   DateTime?

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members      JamMember[]
  messages     JamMessage[]
  invites      JamInvite[]
  moments      JamMoment[]
  queueItems   JamQueueItem[]
  queueVotes   JamQueueVote[]
  skipVotes    JamSkipVote[]
  currentSong  Song?         @relation(fields: [currentSongId], references: [id], onDelete: SetNull)
  currentCinemaVideo  CinemaVideo? @relation("JamCinemaVideo", fields: [currentCinemaVideoId], references: [id], onDelete: SetNull)
  currentAnimeEpisode AnimeEpisode? @relation("JamAnimeEpisode", fields: [currentAnimeEpisodeId], references: [id], onDelete: SetNull)
}

model JamMember {
  jamId    String
  userId   Int
  role     String   @default("MEMBER") // HOST | MINI_HOST | MEMBER
  joinedAt DateTime @default(now())

  jam  Jam  @relation(fields: [jamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([jamId, userId])
}

model JamMessage {
  id        Int      @id @default(autoincrement())
  jamId     String
  userId    Int
  kind      String   @default("TEXT") // TEXT | VOICE
  text      String   @default("")
  mediaId   String?
  createdAt DateTime @default(now())

  jam       Jam          @relation(fields: [jamId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     Media?       @relation("MessageMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  reactions Reaction[]
  reports   MessageReport[]
}

model Media {
  id        String @id
  userId    Int
  kind      String @default("IMAGE") // IMAGE | VOICE
  filename  String
  mime      String
  size      Int
  createdAt DateTime @default(now())

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileUser User? @relation("ProfilePhoto")
  messages     JamMessage[] @relation("MessageMedia")
  dmMessages   DmMessage[] @relation("DmMedia")
  communityMessages CommunityMessage[] @relation("CommunityMedia")
  videoPosts   VideoPost[] @relation("VideoPostAsset")
  videoThumbnails VideoPost[] @relation("VideoPostThumbnail")
  bannerUser      User?      @relation("ProfileBanner")
  tweetAssets     TweetAsset[]
}

model Conversation {
  id        String   @id
  userA     Int
  userB     Int
  createdAt DateTime @default(now())

  userA_ref User @relation("ConvA", fields: [userA], references: [id], onDelete: Cascade)
  userB_ref User @relation("ConvB", fields: [userB], references: [id], onDelete: Cascade)
  messages  DmMessage[]

  @@unique([userA, userB])
}

model DmMessage {
  id        Int      @id @default(autoincrement())
  convId    String
  senderId  Int
  kind      String   @default("TEXT") // TEXT | VOICE
  text      String   @default("")
  mediaId   String?
  seenAt    DateTime?
  createdAt DateTime @default(now())

  conv        Conversation @relation(fields: [convId], references: [id], onDelete: Cascade)
  sender      User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  media       Media?       @relation("DmMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  reactions   Reaction[]
  reports     MessageReport[]
}

model JamInvite {
  id        Int      @id @default(autoincrement())
  jamId     String
  fromId    Int
  toId      Int
  status    SInvite  @default(PENDING) // PENDING | ACCEPTED | DECLINED
  createdAt DateTime @default(now())

  jam  Jam  @relation(fields: [jamId], references: [id], onDelete: Cascade)
  from User @relation("JamInviteFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("JamInviteTo", fields: [toId], references: [id], onDelete: Cascade)
}

enum SInvite {
  PENDING
  ACCEPTED
  DECLINED
}

model Reaction {
  id         Int      @id @default(autoincrement())
  jamMsgId   Int?
  dmMsgId    Int?
  groupMsgId String?
  emoji      String
  userId     Int
  createdAt  DateTime @default(now())

  jamMsg   JamMessage?        @relation(fields: [jamMsgId], references: [id], onDelete: Cascade)
  dmMsg    DmMessage?         @relation(fields: [dmMsgId], references: [id], onDelete: Cascade)
  groupMsg CommunityMessage?  @relation(fields: [groupMsgId], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jamMsgId, userId, emoji])
  @@unique([dmMsgId, userId, emoji])
  @@unique([groupMsgId, userId, emoji])
}

model Artist {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  coverFile String  @default("")
  bio       String  @default("")
  country   String  @default("")
  genres    String  @default("[]") // JSON array of genre strings
  debutYear Int     @default(0)
  createdAt DateTime @default(now())

  songs  Song[]
  albums Album[]
}

model Album {
  id        Int      @id @default(autoincrement())
  title     String
  artistId  Int
  year      Int      @default(0)
  type      String   @default("ALBUM") // SINGLE | EP | ALBUM
  label     String   @default("")
  desc      String   @default("")
  coverFile String   @default("")
  createdAt DateTime @default(now())

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  songs  Song[]
}

model Song {
  id             Int     @id @default(autoincrement())
  title          String
  artistId       Int
  featArtistIds  String  @default("[]") // JSON array of artist ids
  albumId        Int?
  trackNo        Int     @default(0)
  durationSec    Int     @default(0)
  genres         String  @default("[]") // JSON array of genre strings
  producer       String  @default("")
  label          String  @default("")
  year           Int     @default(0)
  explicit       Boolean @default(false)
  featured       Boolean @default(false)
  lyrics         String  @default("")
  lrc            String  @default("")
  coverFile      String  @default("")
  audioFile      String  @default("")
  audioLink      String  @default("")
  plays          Int     @default(0)
  createdAt      DateTime @default(now())

  artist        Artist          @relation(fields: [artistId], references: [id], onDelete: Cascade)
  album         Album?          @relation(fields: [albumId], references: [id], onDelete: SetNull)
  playlistItems MusicPlaylistSong[]
  queueItems    JamQueueItem[]
  jamStates     Jam[]
  favorites     SongFavorite[]
  playHistory   SongPlayHistory[]
  userPlaylistItems UserMusicPlaylistItem[]

  @@index([artistId])
  @@index([albumId])
}

model MusicPlaylist {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  desc      String   @default("")
  coverFile String   @default("")
  featured  Boolean  @default(false)
  createdAt DateTime @default(now())

  items MusicPlaylistSong[]
}

model MusicPlaylistSong {
  id         Int @id @default(autoincrement())
  playlistId Int
  songId     Int
  pos        Int @default(0)

  playlist MusicPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     Song          @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([playlistId, songId])
}

model JamQueueItem {
  id        Int      @id @default(autoincrement())
  jamId     String
  songId    Int
  addedBy   Int
  pos       Int      @default(0)
  createdAt DateTime @default(now())

  jam        Jam  @relation(fields: [jamId], references: [id], onDelete: Cascade)
  song       Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  addedByRef User @relation("JamQueueAdd", fields: [addedBy], references: [id], onDelete: Cascade)
  votes      JamQueueVote[]
}

model SongFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  songId    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
  @@index([userId, createdAt])
}

model SongPlayHistory {
  id       Int      @id @default(autoincrement())
  userId   Int
  songId   Int
  jamId    String?
  playedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt])
  @@index([songId, playedAt])
}

model UserMusicPlaylist {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String
  desc      String   @default("")
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items UserMusicPlaylistItem[]

  @@unique([userId, name])
}

model UserMusicPlaylistItem {
  id         Int @id @default(autoincrement())
  playlistId Int
  songId     Int
  pos        Int @default(0)

  playlist UserMusicPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([playlistId, songId])
}

model JamQueueVote {
  id          Int      @id @default(autoincrement())
  jamId       String
  queueItemId Int
  userId      Int
  createdAt   DateTime @default(now())

  jam       Jam          @relation(fields: [jamId], references: [id], onDelete: Cascade)
  queueItem JamQueueItem @relation(fields: [queueItemId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([queueItemId, userId])
  @@index([jamId, queueItemId])
}

model JamSkipVote {
  id        Int      @id @default(autoincrement())
  jamId     String
  userId    Int
  songId    Int
  createdAt DateTime @default(now())

  jam  Jam  @relation(fields: [jamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jamId, userId, songId])
  @@index([jamId, songId])
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  kind      String
  payload   String    @default("{}")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model TweetMod {
  id        Int      @id @default(autoincrement())
  tweetId   Int?
  adminId   Int
  action    String
  note      String   @default("")
  createdAt DateTime @default(now())

  tweet Tweet? @relation(fields: [tweetId], references: [id], onDelete: SetNull)
  admin User   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([tweetId, createdAt])
  @@index([adminId, createdAt])
}


model MessageReport {
  id             Int       @id @default(autoincrement())
  reporterId     Int
  jamMessageId   Int?
  dmMessageId    Int?
  videoPostId    Int?
  tweetId        Int?
  reason         String
  reasonCategory String    @default("")
  status         String    @default("OPEN")
  createdAt      DateTime  @default(now())

  reporter   User        @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  jamMessage JamMessage? @relation(fields: [jamMessageId], references: [id], onDelete: Cascade)
  dmMessage  DmMessage?  @relation(fields: [dmMessageId], references: [id], onDelete: Cascade)
  videoPost   VideoPost? @relation(fields: [videoPostId], references: [id], onDelete: Cascade)
  tweet       Tweet?     @relation(fields: [tweetId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([tweetId, createdAt])
}

model CreatorApplication {
  id           Int      @id @default(autoincrement())
  userId       Int
  hub          String
  channelName  String
  handle       String
  bio          String   @default("")
  category     String   @default("")
  links        String   @default("[]")
  status       String   @default("PENDING")
  reviewNote   String   @default("")
  reviewerId   Int?
  createdAt    DateTime @default(now())
  reviewedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hub])
  @@index([hub, status, createdAt])
}

model VideoPost {
  id           Int      @id @default(autoincrement())
  authorId     Int
  assetId      String?
  thumbnailAssetId String?
  title        String   @default("")
  description  String   @default("")
  kind         String   @default("POST")
  mediaType    String   @default("TEXT")
  externalUrl  String   @default("")
  thumbnailUrl String   @default("")
  subtitlesUrl String   @default("")
  durationSec  Int      @default(0)
  visibility   String   @default("PUBLIC")
  workflowStatus String  @default("PUBLISHED") // DRAFT | SCHEDULED | PUBLISHED
  publishAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author   User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  asset    Media?      @relation("VideoPostAsset", fields: [assetId], references: [id], onDelete: SetNull)
  thumbnailAsset Media? @relation("VideoPostThumbnail", fields: [thumbnailAssetId], references: [id], onDelete: SetNull)
  likes    VideoLike[]
  saves    VideoSave[]
  comments VideoComment[]
  reports  MessageReport[]
  collabs  VideoCollabInvite[]
  playlistItems VideoPlaylistItem[]

  @@index([kind, visibility, id])
  @@index([authorId, createdAt])
}

model VideoPlaylist {
  id          Int      @id @default(autoincrement())
  userId      Int
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())

  user  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items VideoPlaylistItem[]

  @@unique([userId, name])
  @@index([userId, createdAt])
}

model VideoPlaylistItem {
  id         Int      @id @default(autoincrement())
  playlistId Int
  postId     Int
  note       String   @default("")
  pos        Int      @default(0)
  createdAt  DateTime @default(now())

  playlist VideoPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  post     VideoPost     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([playlistId, postId])
  @@index([playlistId, pos])
  @@index([postId])
}

model JamMoment {
  id        String   @id @default(cuid())
  jamId     String
  userId    Int
  title     String
  kind      String   @default("HIGHLIGHT")
  note      String   @default("")
  snapshot  String   @default("{}")
  createdAt DateTime @default(now())

  jam  Jam  @relation(fields: [jamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jamId, createdAt])
}

model VideoCollabInvite {
  id        Int      @id @default(autoincrement())
  postId    Int
  fromId    Int
  toId      Int
  status    String   @default("PENDING")
  message   String   @default("")
  createdAt DateTime @default(now())

  post VideoPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  from User      @relation("CollabSent", fields: [fromId], references: [id], onDelete: Cascade)
  to   User      @relation("CollabReceived", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([postId, toId])
  @@index([toId, status, createdAt])
}

model VideoLike {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime @default(now())

  post VideoPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model VideoSave {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime @default(now())

  post VideoPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model VideoComment {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  text      String
  createdAt DateTime @default(now())

  post VideoPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model CreatorFollow {
  id         Int      @id @default(autoincrement())
  followerId Int
  creatorId  Int
  createdAt  DateTime @default(now())

  follower User @relation("CreatorFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  creator  User @relation("CreatorFollowers", fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([followerId, creatorId])
  @@index([creatorId, createdAt])
}

model CinemaVideo {
  id           Int      @id @default(autoincrement())
  title        String
  description  String   @default("")
  kind         String   @default("MOVIE")
  externalUrl  String   @default("")
  thumbnailUrl String   @default("")
  subtitlesUrl String   @default("")
  durationSec  Int      @default(0)
  visibility   String   @default("PUBLIC")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jams Jam[] @relation("JamCinemaVideo")

  @@index([kind, visibility, id])
}

enum AnimeType {
  TV
  MOVIE
  OVA
  SPECIAL
}

enum AnimeStatus {
  FINISHED
  AIRING
  UPCOMING
}

model Anime {
  id          Int            @id @default(autoincrement())
  slug        String         @unique
  title       String
  original    String         @default("")
  overview    String         @default("")
  coverFile   String         @default("")
  trailerUrl  String         @default("")
  type        AnimeType      @default(TV)
  status      AnimeStatus    @default(FINISHED)
  year        Int            @default(0)
  episodes    Int            @default(0)
  rating      Float          @default(0)
  genres      String         @default("[]") // JSON array of genre strings
  studio      String         @default("")
  colorFrom   Int            @default(260)
  colorTo     Int            @default(340)
  visibility  String         @default("PUBLIC") // PUBLIC | HIDDEN
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  episodes_   AnimeEpisode[]

  @@index([visibility, id])
  @@index([type, status])
  @@index([rating])
  @@index([year])
}

model AnimeEpisode {
  id          Int      @id @default(autoincrement())
  animeId     Int
  slug        String   @default("") // e.g. "e01" / "s01e01"
  title       String
  number      Int      @default(0)
  externalUrl String   @default("")
  thumbnailUrl String   @default("")
  subtitlesUrl String   @default("")
  durationSec Int      @default(0)
  createdAt   DateTime @default(now())

  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)
  jamCurrent Jam[] @relation("JamAnimeEpisode")

  @@index([animeId, number])
}

model Tweet {
  id           Int      @id @default(autoincrement())
  authorId     Int
  text         String   @default("")
  facets       String   @default("[]")
  replyToId    Int?
  retweetOfId  Int?
  quotedTweetId Int?
  visibility   String   @default("PUBLIC")
  views        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author    User          @relation("UserTweets", fields: [authorId], references: [id], onDelete: Cascade)
  replyTo   Tweet?        @relation("TweetReplies", fields: [replyToId], references: [id], onDelete: Cascade)
  replies   Tweet[]       @relation("TweetReplies")
  retweetOf Tweet?        @relation("TweetRetweets", fields: [retweetOfId], references: [id], onDelete: Cascade)
  retweets  Tweet[]       @relation("TweetRetweets")
  quoted    Tweet?        @relation("TweetQuotes", fields: [quotedTweetId], references: [id], onDelete: SetNull)
  quotes    Tweet[]       @relation("TweetQuotes")
  pinnedBy  User?         @relation("UserPinnedTweet")
  mods      TweetMod[]
  assets    TweetAsset[]
  likes     TweetLike[]
  bookmarks TweetBookmark[]
  reports   MessageReport[]
  hashtags  TweetHashtag[]
  mentions  TweetMention[]
  poll      Poll?
  pollVotes PollVote[]
  viewsLog  TweetView[]
  listItems TweetListTweet[]

  @@index([authorId, createdAt])
  @@index([visibility, id])
  @@index([replyToId, createdAt])
  @@index([retweetOfId, createdAt])
  @@index([quotedTweetId, createdAt])
}

model TweetLike {
  id        Int      @id @default(autoincrement())
  tweetId   Int
  userId    Int
  createdAt DateTime @default(now())

  tweet Tweet @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  user  User  @relation("TweetLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tweetId, userId])
  @@index([userId, createdAt])
}

model TweetBookmark {
  id        Int      @id @default(autoincrement())
  tweetId   Int
  userId    Int
  collectionId Int?
  createdAt DateTime @default(now())

  tweet      Tweet                    @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  user       User                    @relation("TweetBookmarks", fields: [userId], references: [id], onDelete: Cascade)
  collection TweetBookmarkCollection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  @@unique([tweetId, userId])
  @@index([userId, createdAt])
  @@index([collectionId, createdAt])
}

// Bookmark folders — organizing saved tweets.
model TweetBookmarkCollection {
  id        Int      @id @default(autoincrement())
  ownerId   Int
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User           @relation("TweetBookmarkCollections", fields: [ownerId], references: [id], onDelete: Cascade)
  bookmarks TweetBookmark[]

  @@unique([ownerId, name])
  @@index([ownerId, createdAt])
}

model TweetFollow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower User @relation("TweetFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("TweetFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, createdAt])
}

// Follow-request handshake for private accounts.
model TweetFollowRequest {
  id          Int      @id @default(autoincrement())
  requesterId Int
  targetId    Int
  status      String   @default("PENDING") // PENDING | ACCEPTED | DECLINED | CANCELED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("FollowRequestSent", fields: [requesterId], references: [id], onDelete: Cascade)
  target    User @relation("FollowRequestReceived", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([requesterId, targetId])
  @@index([targetId, status])
}

model TweetBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt DateTime @default(now())

  blocker User @relation("TweetBlocking", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("TweetBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId, createdAt])
}

model TweetMute {
  id       Int      @id @default(autoincrement())
  muterId  Int
  mutedId  Int
  createdAt DateTime @default(now())

  muter User @relation("TweetMuting", fields: [muterId], references: [id], onDelete: Cascade)
  muted User @relation("TweetMuted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@unique([muterId, mutedId])
  @@index([mutedId, createdAt])
}

model TweetAsset {
  id        Int      @id @default(autoincrement())
  tweetId   Int
  mediaId   String
  pos       Int      @default(0)
  createdAt DateTime @default(now())

  tweet Tweet @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([tweetId, mediaId])
  @@index([tweetId, pos])
  @@index([mediaId])
}

// Persistent hashtag registry — normalized lowercase keys, unique.
model Hashtag {
  id        Int           @id @default(autoincrement())
  tag       String        @unique
  createdAt DateTime      @default(now())

  tweets    TweetHashtag[]

  @@index([id])
}

// Join table: a tweet "contains" hashtags (extracted at post time).
model TweetHashtag {
  id        Int      @id @default(autoincrement())
  tweetId   Int
  hashtagId Int
  pos       Int      @default(0)

  tweet   Tweet   @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  hashtag Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@unique([tweetId, hashtagId])
  @@index([hashtagId, id])
  @@index([tweetId, id])
}

// Persistent mention registry — extra dedupe + "mentions you" search.
model TweetMention {
  id          Int      @id @default(autoincrement())
  tweetId     Int
  mentionedId Int
  createdAt   DateTime @default(now())

  tweet     Tweet @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  mentioned User  @relation("TweetMentioned", fields: [mentionedId], references: [id], onDelete: Cascade)

  @@unique([tweetId, mentionedId])
  @@index([mentionedId, id])
}

// Polls attached to a tweet (up to 4 options, optional duration).
model Poll {
  id        Int       @id @default(autoincrement())
  tweetId   Int       @unique
  question  String    @default("")
  durationMinutes Int @default(1440) // 0 = never expires
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  tweet   Tweet        @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id     Int    @id @default(autoincrement())
  pollId Int
  text   String

  poll  Poll        @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId]) 
}

model PollVote {
  id       Int      @id @default(autoincrement())
  tweetId  Int
  pollId   Int
  optionId Int
  userId   Int
  createdAt DateTime @default(now())

  tweet  Tweet      @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation("PollVoter", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([tweetId, userId])
  @@index([optionId])
}

// Tweet views/impressions — one row per (tweet, viewer-scope, day) to avoid
// unbounded growth; count aggregates into Tweet.views on read paths.
model TweetView {
  id        Int      @id @default(autoincrement())
  tweetId   Int
  viewerId  Int?
  scope     String   @default("unique") // unique | guest
  day       DateTime @default(now())
  count     Int      @default(1)

  tweet Tweet @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  user  User? @relation("TweetViewer", fields: [viewerId], references: [id], onDelete: SetNull)

  @@unique([tweetId, viewerId, scope, day])
  @@index([tweetId, day])
}

// Per-kind, per-user notification opt-out. Absent row = opted-in.
model NotificationPreference {
  id        Int     @id @default(autoincrement())
  userId    Int
  kind      String  // TWEET_LIKE | TWEET_REPLY | ... (or "ALL" for master switch)
  enabled   Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
  @@index([userId])
}

// Autosaved draft — latest text + media per user.
model Draft {
  id        Int      @id @default(autoincrement())
  userId    Int
  text      String   @default("")
  facets    String   @default("[]")
  mediaIds  String   @default("[]")
  quotedTweetId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

// Scheduled tweet queue — published by a server worker / Scheduler.
model ScheduledTweet {
  id           Int      @id @default(autoincrement())
  userId       Int
  text         String   @default("")
  facets       String   @default("[]")
  mediaIds     String   @default("[]")
  replyToId    Int?
  publishAt    DateTime
  status       String   @default("PENDING") // PENDING | PUBLISHED | CANCELED | FAILED
  createdAt    DateTime @default(now())
  publishedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, publishAt])
  @@index([userId, publishAt])
}

// Reward/creator-like lists — public curated collections of users.
model TweetList {
  id          Int      @id @default(autoincrement())
  ownerId     Int
  name        String
  description String   @default("")
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now())

  owner   User              @relation("TweetListOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members TweetListMember[]
  tweets  TweetListTweet[]

  @@unique([ownerId, name])
  @@index([ownerId, createdAt])
}

model TweetListMember {
  id        Int      @id @default(autoincrement())
  listId    Int
  memberId  Int
  createdAt DateTime @default(now())

  list   TweetList @relation(fields: [listId], references: [id], onDelete: Cascade)
  member User      @relation("TweetListMemberships", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([listId, memberId])
  @@index([memberId])
}

// A bookmarked/curated tweet inside a list.
model TweetListTweet {
  id        Int      @id @default(autoincrement())
  listId    Int
  tweetId   Int
  addedBy   Int
  createdAt DateTime @default(now())

  list TweetList @relation(fields: [listId], references: [id], onDelete: Cascade)
  tweet Tweet    @relation(fields: [tweetId], references: [id], onDelete: Cascade)

  @@unique([listId, tweetId])
  @@index([tweetId])
}

// ----- Community hub: persistent groups where members chat in channels -----

// A group / community anyone can create. Public groups are joinable from browse.
model Community {
  id        String   @id @default(cuid())
  name      String
  desc      String   @default("")
  avatarId  Int      @default(0)
  isPrivate Boolean  @default(false)
  ownerId   Int
  createdAt DateTime @default(now())

  owner    User               @relation("CommunityOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  members  CommunityMember[]
  channels CommunityChannel[]
  messages CommunityMessage[]

  @@index([ownerId])
  @@index([createdAt])
}

model CommunityMember {
  communityId String
  userId      Int
  role        String    @default("MEMBER") // OWNER | ADMIN | MEMBER
  lastReadAt  DateTime?
  joinedAt    DateTime  @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([communityId, userId])
  @@index([userId])
}

model CommunityChannel {
  id          String   @id @default(cuid())
  communityId String
  name        String   @default("general")
  description String   @default("")
  createdBy   Int
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  creator   User      @relation("CommunityChannelsCreated", fields: [createdBy], references: [id], onDelete: Cascade)
  messages  CommunityMessage[]

  @@index([communityId])
}

model CommunityMessage {
  id          String   @id @default(cuid())
  communityId String
  channelId   String
  userId      Int
  kind        String   @default("TEXT") // TEXT | VOICE
  text        String   @default("")
  mediaId     String?
  createdAt   DateTime @default(now())

  community Community        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  channel   CommunityChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     Media?           @relation("CommunityMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  reactions Reaction[]

  @@index([communityId, channelId, createdAt])
  @@index([userId])
}
