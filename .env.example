DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# GitHub OAuth (optional — leave empty to hide the button)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_REDIRECT_URI="http://localhost:3000/api/auth/github/callback"
# Google OAuth (optional — leave empty to hide the button; callback path must
# match a redirect URI registered in the Google Cloud Console)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"
# Set to "0" when running over plain HTTP locally (keeps session cookies usable)
COOKIE_SECURE="0"
# Super admin (site owner) credentials for the dedicated /super-login panel.
SUPER_ADMIN_USERNAME="superadmin"
SUPER_ADMIN_PASSWORD=""
# Render Persistent Disk mount or object-storage-backed local path for uploaded media
UPLOAD_DIR="uploads"
# Optional: share Socket.IO presence, notifications and room events across instances
REDIS_URL="redis://localhost:6379"
